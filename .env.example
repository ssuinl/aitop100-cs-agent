# 카카오톡 봇 ([제품 설정] > [카카오톡 봇] > [봇]의 봇 인증 토큰)
BOT_TOKEN=
# 웹훅 설정에서 커스텀 헤더를 등록했다면 (선택, 권장)
WEBHOOK_SECRET_HEADER=X-Webhook-Secret
WEBHOOK_SECRET_VALUE=아무_긴_랜덤문자열

# LLM: anthropic 또는 openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1
# OPENAI_API_KEY=

# 운영진 액션 API (당일 문제 페이지 보고 채움)
ACTION_API_BASE=
ACTION_API_KEY=

# 선택
QUICK_REPLIES=오늘 시세|주문하기|배송 안내
WELCOME_TEXT=안녕하세요! 무엇을 도와드릴까요?
MOCK_ACTIONS=0
